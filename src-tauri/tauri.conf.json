{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tetorica SMSGEAR Synth",
  "version": "0.100.1",
  "identifier": "net.tetorica.synth-smsgear-ym2413",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/check-release.cjs",
    "beforeBuildCommand": "node scripts/check-release.cjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tetorica SMSGEAR Synth",
        "width": 1280,
        "height": 900,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled",
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../native-sources/"
    ]
  }
}
